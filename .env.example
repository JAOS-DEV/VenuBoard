# VenuBoard environment template.
#
# Copy to .env.local and fill in. .env.local is git-ignored; only this template
# is committed. NEVER put a real credential in this file.
#
#   cp .env.example .env.local        (macOS / Linux)
#   Copy-Item .env.example .env.local (Windows PowerShell)

# ---------------------------------------------------------------------------
# Environment identifier — REQUIRED, no default, no fallback.
# ---------------------------------------------------------------------------
# One of: local | staging | production | test
#
# There is deliberately no default. An unset or misspelled value fails
# validation at boot rather than being assumed to be local (ADR-034), so
# production can never silently inherit local or staging behaviour.
#
# A badge is shown in local and staging only; production never displays it.
VENUBOARD_ENV=local

# ---------------------------------------------------------------------------
# Supabase — browser-exposed values (safe to inline into client bundles)
# ---------------------------------------------------------------------------
# Optional in local and test: the application shell renders without them.
# REQUIRED in staging and production.
#
# For a local stack, `npx supabase start` prints these (requires Docker).
# After `npm run db:reset`, the local database has the foundation schema and
# fictional seed data. No hosted Supabase project exists; nothing here points at one.

# API URL. Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — safe for the browser, subject to Row Level Security.
# (Formerly called the anon key. Both name and value come from the Supabase
# project's API settings, or from `npx supabase start` locally.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of this Next.js app (no trailing slash). Used for Auth
# callback URLs and invitation links. Optional in local and test.
# Local application origin is http://localhost:3000. Leave this empty locally
# rather than setting 127.0.0.1:3000 — API, Studio and mailbox stay there.
NEXT_PUBLIC_APP_ORIGIN=

# ---------------------------------------------------------------------------
# Supabase — server-only secret. NEVER prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# The secret key (formerly the service-role key) BYPASSES Row Level Security,
# which is the mechanism keeping tenants apart. It is therefore:
#   - never referenced by browser code,
#   - never used on a request path serving tenant users,
#   - not needed at all in this scaffold phase — leave it empty.
#
# Validation rejects any NEXT_PUBLIC_ variable whose name implies a secret, so a
# misplaced prefix fails the boot instead of shipping.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Playwright-only test identity cookie. Server-only. Leave unset.
# ---------------------------------------------------------------------------
# Honoured only when ALL of these are true:
#   VENUBOARD_ENV=test
#   NODE_ENV is not production
#   this flag is 1 or true
#
# Never set this in local, staging, preview, or production. Never prefix with
# NEXT_PUBLIC_. Values other than 1/true do not enable the cookie.
# VENUBOARD_ENABLE_TEST_IDENTITY=
